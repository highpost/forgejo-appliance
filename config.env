FORGEJO_VM="forgejo-appliance"
FORGEJO_YAML="forgejo-appliance.yml"
TS_STATE_CACHE="tsbridge-state-cache"
TS_OAUTH_SECRET_KEY="tsbridge-oauth-secret"

# Tailscale configuration (required)
TS_MACHINE_NAME=${UPDATE_ME:?"FATAL: provide a valid TS_MACHINE_NAME in config.env"}
TS_OAUTH_CLIENT_ID=${UPDATE_ME:?"FATAL: provide a valid TS_OAUTH_CLIENT_ID in config.env"}
TS_TAILNET=${UPDATE_ME:?"FATAL: provide a valid TS_TAILNET in config.env"}

# Borg backup configuration (optional - for remote backups)
# rsync.net example: BORG_REPO="zh1234@zh1234.rsync.net:forgejo-backup"
BORG_REPO=""
BORG_PASSPHRASE_KEY="borg-passphrase"
BORG_ARCHIVE_NAME="::{now:%Y-%m-%d}"

# Borg backup retention policy (optional)
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=6
BORG_KEEP_YEARLY=""

# optional raw override for custom Borg prune flags (e.g. "--keep-within=14d")
BORG_RETENTION_POLICY=""
